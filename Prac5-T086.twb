      <aliases enabled='yes' />
      <column caption='Cumulative Votes (RUNNING_SUM). ' datatype='integer' name='[Calculation_0239447700324356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Restaurant Rank ' datatype='integer' name='[Calculation_0239447705661448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([votes]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='City Window Avg Cost.' datatype='real' name='[Calculation_0239447706902537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(AVG([approx_cost(for two people)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Difference from Window Sum. ' datatype='real' name='[Calculation_0239447708782602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([votes]) - WINDOW_AVG(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dynamic Title' datatype='string' name='[Calculation_0239447723319309]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Top &quot; + STR([Parameters].[Parameter 0239447721476108]) + &quot; Restaurants by Total&#13;&#10;Votes&quot;' />
      </column>
